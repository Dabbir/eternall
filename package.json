{
  "name": "eternall-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ETERNALL — a private publishing house for your life.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @eternall/web",
    "build": "npm run typecheck && npm run build -w @eternall/web && node scripts/check-budgets.mjs",
    "preview": "npm run preview -w @eternall/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings apps packages modules services"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
