+import { useEffect, useRef, useState } from 'react';
+import ui from '../../components/ui.module.css';
+import { serializeForExport } from '../../domain/storage';
+import { useStore } from '../../state/store';
+import styles from './Settings.module.css';
+
+/**
+ * AMAZEEN is moving into ETERNALL. This hands the whole archive to ETERNALL's door
+ * (`/amazeen/import`) in one step, browser to browser: no server sees it.
+ * Only ETERNALL's origin is trusted, and every exchange carries ETERNALL's one-time nonce.
+ */
+export const ETERNALL_ORIGIN: string = import.meta.env.VITE_ETERNALL_ORIGIN ?? 'https://eternall.app';
+
+type MoveState = { step: 'idle' } | { step: 'moving' } | { step: 'done'; added: number } | { step: 'error'; message: string };
+
+export function MoveSection() {
+  const { data } = useStore();
+  const [state, setState] = useState<MoveState>({ step: 'idle' });
+  const cleanup = useRef<() => void>(() => {});
+  useEffect(() => () => cleanup.current(), []);
+
+  const move = () => {
+    const popup = window.open(`${ETERNALL_ORIGIN}/amazeen/import`, 'eternall-move', 'popup,width=760,height=860');
+    if (!popup) {
+      setState({ step: 'error', message: 'Your browser blocked the window. Allow pop-ups for this site, or export a backup and import it in ETERNALL.' });
+      return;
+    }
+    setState({ step: 'moving' });
+    const onMessage = (e: MessageEvent) => {
+      if (e.origin !== ETERNALL_ORIGIN || e.source !== popup) return;
+      const msg = e.data as { type?: string; nonce?: string; added?: number; message?: string };
+      if (msg?.type === 'eternall:ready' && typeof msg.nonce === 'string') {
+        popup.postMessage({ type: 'amazeen:archive', nonce: msg.nonce, archive: serializeForExport(data) }, ETERNALL_ORIGIN);
+      } else if (msg?.type === 'eternall:done') {
+        setState({ step: 'done', added: msg.added ?? 0 });
+        cleanup.current();
+      } else if (msg?.type === 'eternall:error') {
+        setState({ step: 'error', message: msg.message ?? 'ETERNALL couldn’t read the archive.' });
+      }
+    };
+    window.addEventListener('message', onMessage);
+    cleanup.current = () => window.removeEventListener('message', onMessage);
+  };
+
+  return (
+    <section className={styles.section} aria-labelledby="s-move">
+      <div className={styles.sectionIntro}>
+        <h2 id="s-move">AMAZEEN is moving</h2>
+        <p>AMAZEEN now lives in ETERNALL, the same magazine with an encrypted vault and a lifeline around it. Moving takes one step and keeps every issue.</p>
+      </div>
+      <div className={styles.actions}>
+        <button type="button" className={`${ui.btn} ${ui.primary}`} onClick={move} disabled={state.step === 'moving'}>
+          {state.step === 'moving' ? 'Moving…' : 'Move to ETERNALL'}
+        </button>
+        <p className={styles.status} role="status" aria-live="polite">
+          {state.step === 'done' && `Moved: ${state.added} pieces arrived in ETERNALL. Your copy here is untouched until you erase it.`}
+          {state.step === 'error' && state.message}
+        </p>
+      </div>
+    </section>
+  );
+}
